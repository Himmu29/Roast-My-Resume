---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { ResultDashboard } from '../components/dashboard/ResultDashboard';
---

<Layout
  title="Your AI Resume Audit & Roast Dashboard | Roast My Resume AI"
  description="View your instant AI resume roast, estimated ATS score, missing industry keywords, STAR bullet point rewrites, and live voice recruiter session."
  keywords="roast my resume dashboard, roast my cv results, ai resume roaster, ats score audit"
>
  <Header />

  <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <ResultDashboard client:only="react" />
  </main>

  <Footer />
</Layout>
