---
import { Flame } from 'lucide-react';
---

<footer class="w-full border-t border-neutral-200 bg-neutral-50/50 py-8 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 font-mono">
    <div class="flex items-center gap-2">
      <Flame class="w-4 h-4 text-neutral-400" />
      <span>Roast My Resume &copy; {new Date().getFullYear()}</span>
    </div>
    <div class="flex items-center gap-6">
      <span>AI Resume Audit & Interactive Voice Coach</span>
      <span>Vercel Design System</span>
    </div>
  </div>
</footer>
