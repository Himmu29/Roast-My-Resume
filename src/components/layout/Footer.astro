---
import { Flame } from 'lucide-react';
---

<footer class="w-full border-t border-hairline bg-canvas-soft py-8 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute font-mono">
    <div class="flex items-center gap-2">
      <Flame class="w-4 h-4 text-mute" />
      <span>Roast My Resume &copy; {new Date().getFullYear()}</span>
    </div>
    <div class="flex items-center gap-6">
      <span>Powered by Gemini API & VAPI Web SDK</span>
      <span>Design inspired by Vercel</span>
    </div>
  </div>
</footer>
