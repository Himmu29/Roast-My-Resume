---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string;
}

const defaultTitle = 'Roast My Resume AI - Free AI Resume Roaster & ATS Score Checker';
const defaultDescription = 'Roast my resume with instant AI feedback! Get a funny & constructive resume roast, estimated ATS compatibility score, STAR bullet point rewrites, and live voice chat with an AI recruiter.';
const defaultKeywords = 'roast my resume, roast my cv, roast my resume ai, ai resume roaster, roast my cv ai, resume audit, ats resume checker, AI career coach';

const {
  title = defaultTitle,
  description = defaultDescription,
  image = '/og-image.png',
  canonical,
  keywords = defaultKeywords,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;
const ogImageURL = new URL(image, Astro.url.origin).href;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Roast My Resume AI',
  url: canonicalURL,
  description: description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Roast My Resume AI" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Google Fonts for Geist, Inter & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-white text-neutral-900 font-sans antialiased selection:bg-neutral-900 selection:text-white flex flex-col min-h-screen">
    <slot />
  </body>
</html>
