# 1. Gemini API Keys (Required for Resume Parsing & JSON Analysis)
# Get free keys at: https://aistudio.google.com
# Supports automatic failover if primary key daily quota (e.g. 20 requests) is exhausted
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEY_1=your_fallback_gemini_api_key_1_here
GEMINI_API_KEY_2=your_fallback_gemini_api_key_2_here

# 2. VAPI Credentials (For Client WebRTC AI Voice Calls)
# Get free keys & assistant IDs at: https://vapi.ai
# Supports automatic multi-key & assistant ID failover rotation
PUBLIC_VAPI_API_KEY=your_vapi_public_key_here
PUBLIC_VAPI_API_KEY_1=your_fallback_vapi_public_key_1_here
PUBLIC_VAPI_API_KEY_2=your_fallback_vapi_public_key_2_here

PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
PUBLIC_VAPI_ASSISTANT_ID_1=your_fallback_vapi_assistant_id_1_here
PUBLIC_VAPI_ASSISTANT_ID_2=your_fallback_vapi_assistant_id_2_here

VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_PRIVATE_KEY_1=your_fallback_vapi_private_key_1_here
VAPI_PRIVATE_KEY_2=your_fallback_vapi_private_key_2_here
