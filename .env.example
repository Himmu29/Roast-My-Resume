# 1. Gemini API Key (Required for Resume Parsing & JSON Analysis)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 2. VAPI Public Key (Optional in .env, can also be entered directly in the web UI)
# Get a free key at: https://vapi.ai
PUBLIC_VAPI_API_KEY=your_vapi_public_key_here
